{
  "name": "nexo",
  "version": "0.4.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "engine:test": "node tools/runtime-node.mjs tools/contract-tests.mjs",
    "dev": "node tools/dev.mjs",
    "backend:build": "node tools/cargo.mjs build --locked --release -p nexo-server",
    "backend:test": "node tools/cargo.mjs test --locked --workspace --exclude nexo-desktop",
    "desktop:dev": "node tools/tauri.mjs dev",
    "desktop:build": "node tools/tauri.mjs build",
    "test:architecture": "node tools/check-architecture.mjs",
    "check": "npm run test:architecture && ng build",
    "build:desktop": "ng build --configuration desktop",
    "backend:clippy": "node tools/cargo.mjs clippy --locked --workspace --exclude nexo-desktop --all-targets -- -D warnings",
    "test:server": "node tools/runtime-node.mjs tools/verify-server.mjs",
    "nexo": "node tools/cli.mjs",
    "test:packages": "node --test tools/package-manifests.test.mjs",
    "test:bootstrap": "node --test tools/bootstrap/*.test.mjs",
    "i18n:check": "node tools/check-i18n.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"tests/**/*.mjs\" \"e2e/**/*.mjs\" \"tools/**/*.mjs\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"tests/**/*.mjs\" \"e2e/**/*.mjs\" \"tools/**/*.mjs\" \"*.mjs\"",
    "verify": "npm run test:architecture && npm run i18n:check && npm run format:check && npm run lint && npm test -- --watch=false && npm run engine:test && npm run test:packages && npm run test:bootstrap && npm run backend:test && npm run backend:clippy && npm run build && npm run build:desktop",
    "web": "node tools/runtime-node.mjs tools/install/web.mjs",
    "e2e": "playwright test",
    "lint": "eslint src",
    "test:coverage": "ng test --watch=false --coverage",
    "desktop:msix": "node tools/runtime-node.mjs tools/package-msix.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "//": [
    "Build tools (Angular CLI and compiler, TypeScript, Tauri CLI) are dependencies so that the install scripts can run npm ci --omit=dev: nothing here ships at runtime, Angular bundles only what the app imports. Lint, tests and test servers stay in devDependencies."
  ],
  "dependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@jsverse/transloco": "8.4.0",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "cm6-graphql": "1.0.0",
    "graphql": "17.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "mqtt-packet": "9.0.2",
    "prettier": "3.9.10",
    "socket.io": "4.8.4",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "ws": "8.22.1",
    "yaml": "2.9.1"
  }
}
