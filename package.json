{
  "name": "nexo",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:nexo": "node tools/runtime-node.mjs dist/nexo/server/server.mjs",
    "engine:build": "node tools/build-engine.mjs",
    "engine:test": "node tools/runtime-node.mjs --test engine/test/*.test.mjs",
    "dev": "node tools/dev.mjs",
    "backend:build": "node tools/cargo.mjs build --locked --release -p nexo-server",
    "backend:test": "node tools/cargo.mjs test --locked --workspace --exclude nexo-desktop",
    "desktop:prepare": "node tools/prepare-desktop.mjs",
    "desktop:dev": "node tools/tauri.mjs dev",
    "desktop:build": "npm run engine:build && npm run desktop:prepare && node tools/tauri.mjs build",
    "test:architecture": "node tools/check-architecture.mjs",
    "e2e": "npm run test:server && npm run test:ssr",
    "check": "npm run test:architecture && ng build",
    "build:desktop": "ng build --configuration desktop",
    "backend:clippy": "node tools/cargo.mjs clippy --locked --workspace --exclude nexo-desktop -- -D warnings",
    "test:server": "node tools/runtime-node.mjs tools/verify-server.mjs",
    "test:ssr": "node tools/runtime-node.mjs tools/verify-ssr.mjs",
    "server:start": "node tools/start-server.mjs",
    "nexo": "node tools/cli.mjs",
    "preview:server": "node tools/preview-server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/ssr": "22.2.5",
    "@tauri-apps/api": "2.12.4",
    "express": "5.3.0",
    "http-proxy-middleware": "4.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "socket.io": "4.8.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "workspaces": [
    "engine"
  ]
}