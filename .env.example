# docker compose up --build
NEXO_WEB_BIND=127.0.0.1
NEXO_PUBLIC_HOSTS=localhost,127.0.0.1
NEXO_ORIGINS=http://localhost:4000
NEXO_ALLOW_SIGNUP=false
# Optional persistent 32-byte master key, encoded as 64 hexadecimal characters.
# Without this override a key is generated inside the private data volume.
NEXO_MASTER_KEY=
